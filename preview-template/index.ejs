<html>

<head>
	<link rel="icon" href="./favicon.ico" />
	<meta charset="utf-8" />
	<title>
		<%=title%>
	</title>
	<meta name="viewport"
		content="width=device-width,user-scalable=no,initial-scale=1,minimum-scale=1,maximum-scale=1,minimal-ui=true" />
	<meta name="apple-mobile-web-app-capable" content="yes" />
	<meta name="mobile-web-app-capable" content="yes">
	<meta name="full-screen" content="yes" />
	<meta name="screen-orientation" content="portrait" />
	<meta name="x5-fullscreen" content="true" />
	<meta name="360-fullscreen" content="true" />
	<meta name="renderer" content="webkit" />
	<meta name="force-rendering" content="webkit" />
	<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />

	<link rel="stylesheet" type="text/css" href="./index.css" />

	<style type="text/css">
		* {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      .loading-page {
        position: absolute;
        flex: 1;
        width: 100%;
        height: 100%;
        /* background-image: url(./images/loading_bg.jpeg); */
        background-color: black;
        z-index: 2;
        background-position: center;
        background-repeat: no-repeat;
        background-size: var(--bg-size);
      }

      .loading-page-wrapper {
        display: none;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        margin-top: 1.67rem;
      }

      .loading-page-logo {
        position: absolute;
        top: 40%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 2.21rem;
        font-size: 0;
      }

      .loading-page-progress {
        margin-top: 0.3rem;
        width: 2.21rem;
        position: relative;
      }

      .progress-back {
        width: 2.21rem;
        height: 8px;
        border-radius: 8px;
        background-color: #574b2f;
      }

      .progress-val {
        z-index: 1;
        position: absolute;
        top: 0;
        height: 8px;
        border-radius: 8px;
        background-color: #efa300;
        width: 0px;
        transition: all 100ms;
      }

      .loading-page-logo img {
        width: 100%;
        height: auto;
      }

      .fade-in {
        opacity: 0;
        animation: fadeOut 1s ease-out forwards;
      }

      @keyframes fadeOut {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
	</style>
</head>

<body style="overflow: hidden;">
	<%- include(cocosToolBar, {config: config}) %>
		<div id="content" class="content" style="overflow: hidden;">
			<div class="contentWrap">
				<div id="GameDiv" class="wrapper">
					<div id="Cocos3dGameContainer">
						<canvas id="GameCanvas" tabindex="-1" style="background-color: '';"></canvas>
					</div>
					<div id="splash">
						<div class="progress-bar stripes"><span></span></div>
					</div>
					<div id="bulletin">
						<div id="sceneIsEmpty" class="inner">
							<%=tip_sceneIsEmpty%>
						</div>
					</div>
					<div class="error" id="error">
						<div class="title">Error <i>(Please open the console to see detailed errors)</i></div>
						<div class="error-main"></div>
						<div class="error-stack"></div>
					</div>
				</div>
			</div>
		</div>
		<div class="loading-page" id="loading-page">
			<div class="loading-page-logo">
				<img src="./images/logo.png" alt="logo">
				<div class="loading-page-progress">
					<div class="progress-back"></div>
					<div class="progress-val" id="progress-val"></div>
				</div>
			</div>
		</div>
		<%- include(cocosTemplate, {}) %>
		<script>
      console.time('start game');
      (function () {
        function initBaseSize() {
          // 设计稿宽度
          var designWidth = 750;
          // 设计稿高度
          var designHeight = 1334;
          // 屏幕宽度
          var innerWidth = window.innerWidth;
          // 屏幕高度
          var innerHeight = window.innerHeight;
          // 宽度缩放比例
          var scaleX = innerWidth / designWidth;
          // 高度缩放比例
          var scaleY = innerHeight / designHeight;
          var minScale = Math.min(scaleX, scaleY);
          var contentWidth = innerWidth * 0.8;
          // 背景图原始宽度
          var bgOriginWidth = 750;
          // 背景图原始高度
          var bgOriginHeight = 1334;
          // 宽度缩放比例
          var scaleX = innerWidth / designWidth;
          // 高度缩放比例
          var scaleY = innerHeight / designHeight;
          var minScale = Math.min(scaleX, scaleY);
          // 缩放后的背景图宽度
          var bgWidth = bgOriginWidth * minScale;
          // 缩放后的背景图高度
          var bgHeight = bgOriginHeight * minScale;
          document.documentElement.style.setProperty(
            '--window-width',
            innerWidth + 'px'
          );
          document.documentElement.style.setProperty(
            '--window-content-width',
            contentWidth + 'px'
          );
          document.documentElement.style.setProperty(
            '--render-ui-scale',
            minScale
          );
          document.documentElement.style.setProperty(
            '--bg-size',
            bgWidth + 'px ' + bgHeight + 'px'
          );
          // 设计稿尺寸是 1125 * 2436, 以1rem = 100px 为基准
          // 然后屏幕的全屏就等于1125 / 100 = 11.25rem
          // 然后根据屏幕的实际大小，设置根节点的fontSize
          var rem = minScale * 100;
          document.documentElement.style.setProperty('font-size', rem + 'px');
        }

        initBaseSize();
        window.onresize = function () {
          initBaseSize();
        };

        window.ccEngineProgress = (progress) => {
          document.getElementById('progress-val').style.width =
            progress * 4.21 + 'rem';
        };
        console.time('Game init total time');
      })();
    </script>
			<script>
				(function () {
					var loadingPage = document.getElementById('loading-page');
					window.showProgressBar = function showProgressBar() {
						loadingPage.style.display = 'block';
					}
					window.hideLoadingPage = function hideLoadingPage() {
						console.log('hideLoadingPage');
						loadingPage.style.opacity = 0;
						loadingPage.style.perspective = '1000px';
						loadingPage.style.transition = 'all 0.2s ease-out';
						loadingPage.addEventListener('transitionend', function () {
							loadingPage.style.display = 'none';
						});
					}
				})();
			</script>

</body>

</html>