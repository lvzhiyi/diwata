<html>

<head>
	<link rel="icon" href="./favicon.ico" />
	<meta charset="utf-8" />
	<title>
		<%=title%>
	</title>
	<meta name="viewport"
		content="width=device-width,user-scalable=no,initial-scale=1,minimum-scale=1,maximum-scale=1,minimal-ui=true" />
	<meta name="apple-mobile-web-app-capable" content="yes" />
	<meta name="mobile-web-app-capable" content="yes">
	<meta name="full-screen" content="yes" />
	<meta name="screen-orientation" content="portrait" />
	<meta name="x5-fullscreen" content="true" />
	<meta name="360-fullscreen" content="true" />
	<meta name="renderer" content="webkit" />
	<meta name="force-rendering" content="webkit" />
	<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
  <link rel="preload" href="./images/10.png" />
  <link rel="preload" href="./images/20.png" />
	<link rel="stylesheet" type="text/css" href="./index.css" />

	<style type="text/css">
		* {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      /* =========================================
         样式 A: 默认 Loading (无参数 c 时显示)
         ========================================= */
      .loading-page {
        position: absolute;
        flex: 1;
        width: 100%;
        height: 100%;
        background-color: black;
        z-index: 2;
        background-position: center;
        background-repeat: no-repeat;
        /* background-size: var(--bg-size); */
        display: none; /* 默认隐藏，由 JS 控制显示 */
      }

      .loading-page-logo {
        position: absolute;
        top: 40%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 2.21rem;
        font-size: 0;
      }

      .loading-page-progress {
        margin-top: 0.3rem;
        width: 2.21rem;
        position: relative;
      }

      .loading-page-logo img {
        width: 100%;
        height: auto;
      }

      /* =========================================
         样式 B: 营销 Loading (有参数 c 时显示)
         ========================================= */
      .sm-logo-container {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: #000;
        background-image: url("./images/bg.webp");
        background-repeat: no-repeat;
        background-size: 100% 100%;
        background-position: center;
        z-index: 3; /* 比默认 loading 层级高 */
        display: none; /* 默认隐藏，由 JS 控制显示 */
      }
      .logo-container {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        height: 100%;
        flex-direction: column;
        transform: translateY(-3%);
      }
      .sm-img {
        width: 2.38rem;
        height: auto;
      }
      .middle-box {
        min-height: 3rem;
        position: relative;
      }
      .num-img {
        width: 1.04rem;
        position: absolute;
        top: 2.01rem;
        left: 1.88rem;
        display: none;
      }
      .free-img {
        width: 7.5rem;
        height: auto;
        margin-top: -0.3rem;
        display: none;
      }
      .loading-text {
        font-size: 0.2rem;
        color: rgba(255, 255, 255, 0.6);
        margin-top: 0.05rem;
        text-align: center; /* 文字内部居中 */

      }

      /* =========================================
         通用组件: 进度条 (两套 UI 共用样式)
         ========================================= */
      .progress-back {
        width: 2.21rem; /* 默认样式宽度 */
        height: 8px;
        border-radius: 8px;
        background-color: #574b2f;
      }

      /* 营销界面的进度条可能需要不同的宽度，这里微调 */
      .sm-logo-container .progress-bar {
         width: 1.72rem;
         height: 0.1rem;
         margin: 0 auto;
         overflow: hidden;
         border-radius: 0.1rem;
         background-color: #574b2f;
      }
      .sm-logo-container .progress-bar-inner {
         width: 0%;
         height: 100%;
         background-color: #f6c412;
      }

      .progress-val {
        z-index: 1;
        position: absolute;
        top: 0;
        height: 8px;
        border-radius: 8px;
        background-color: #efa300;
        width: 0px;
        transition: all 100ms;
      }

      .fade-in {
        opacity: 0;
        animation: fadeOut 1s ease-out forwards;
      }

      @keyframes fadeOut {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
	</style>
</head>

<body style="overflow: hidden;">
	<%- include(cocosToolBar, {config: config}) %>
		<div id="content" class="content" style="overflow: hidden;">
			<div class="contentWrap">
				<div id="GameDiv" class="wrapper">
					<div id="Cocos3dGameContainer">
						<canvas id="GameCanvas" tabindex="-1" style="background-color: '';"></canvas>
					</div>
					<div id="splash">
						<div class="progress-bar stripes"><span></span></div>
					</div>
					<div id="bulletin">
						<div id="sceneIsEmpty" class="inner">
							<%=tip_sceneIsEmpty%>
						</div>
					</div>
					<div class="error" id="error">
						<div class="title">Error <i>(Please open the console to see detailed errors)</i></div>
						<div class="error-main"></div>
						<div class="error-stack"></div>
					</div>
				</div>
			</div>
		</div>

        <!-- UI A: 默认 Loading 界面 -->
		<div class="loading-page" id="default-loading-page">
			<div class="loading-page-logo">
				<img src="./images/logo.png" alt="logo"> <!-- 确保有默认 logo -->
				<div class="loading-page-progress">
					<div class="progress-back"></div>
					<div class="progress-val" id="default-progress-val"></div>
				</div>
        <div class="loading-text">Loading...</div>
			</div>
		</div>

        <!-- UI B: 营销 Loading 界面 -->
        <div class="sm-logo-container" id="promo-loading-page">
            <div class="logo-container">
                <img class="sm-img" src="./images/logo.ico" />
                <div class="middle-box">
                    <img class="num-img" data-num="10" src="./images/10.png" />
                    <img class="num-img" data-num="20" src="./images/20.png" />
                </div>
                <!-- 营销版进度条容器 -->
                <div class="progress-bar">
                    <div class="progress-bar-inner" id="promo-progress-val"></div>
                </div>
                <div class="loading-text">Loading...</div>
            </div>
        </div>

		<%- include(cocosTemplate, {}) %>
		<script>
      console.time('start game');
      (function () {
        function initBaseSize() {
          var designWidth = 750;
          var designHeight = 1334;
          var innerWidth = window.innerWidth;
          var innerHeight = window.innerHeight;
          var scaleX = innerWidth / designWidth;
          var scaleY = innerHeight / designHeight;
          var minScale = Math.min(scaleX, scaleY);
          var contentWidth = innerWidth * 0.8;
          var bgOriginWidth = 750;
          var bgOriginHeight = 1334;
          var bgWidth = bgOriginWidth * minScale;
          var bgHeight = bgOriginHeight * minScale;

          document.documentElement.style.setProperty('--window-width', innerWidth + 'px');
          document.documentElement.style.setProperty('--window-content-width', contentWidth + 'px');
          document.documentElement.style.setProperty('--render-ui-scale', minScale);
          document.documentElement.style.setProperty('--bg-size', bgWidth + 'px ' + bgHeight + 'px');

          var rem = minScale * 100;
          document.documentElement.style.setProperty('font-size', rem + 'px');
        }

        initBaseSize();
        window.onresize = function () {
          initBaseSize();
        };

        // 统一控制进度条更新的核心函数
        function updateProgress(progress) {
            console.log('Loading Progress:', progress);
            // 更新默认界面的进度条
            var defVal = document.getElementById('default-progress-val');
            if(defVal) defVal.style.width = progress * 2.21 + 'rem';

            // 更新营销界面的进度条
            var promoVal = document.getElementById('promo-progress-val');
            if(promoVal) {
                promoVal.style.width = (progress * 100) + '%';
            }
        }

        // 监听 Cocos 3.x 标准回调
        window.ccEngineProgress = updateProgress;

        // 监听参考模板中的回调 (以防万一)
        window.onEngineLoadProgress = function(percent) {
            // 有的引擎版本传进来是 0-100，有的是 0-1
            var p = percent > 1 ? percent / 100 : percent;
            updateProgress(p);
        };

        // 【兜底方案】模拟进度条 (仅在预览模式生效)
        // 如果 1秒内没有收到任何进度回调，就自动跑进度，防止进度条卡死
        var hasReceivedProgress = false;
        var fakeProgress = 0;
        setTimeout(function() {
            if (!hasReceivedProgress) {
                console.log('No progress received, starting fake progress...');
                var timer = setInterval(function() {
                    if (fakeProgress < 0.9) {
                        fakeProgress += 0.05;
                        updateProgress(fakeProgress);
                    } else {
                        clearInterval(timer);
                    }
                }, 200);
            }
        }, 1000);

        // 劫持 updateProgress 标记已收到真实进度
        var originalUpdate = updateProgress;
        updateProgress = function(p) {
            hasReceivedProgress = true;
            originalUpdate(p);
        };

        console.time('Game init total time');
      })();
    </script>
			<script>
				(function () {
                    // --- 核心逻辑：根据 URL 参数决定显示哪套 UI ---
                    const params = new URLSearchParams(location.search);
                    // const c = params.get("c");

                    // const c = params.get("c");
                    const c = params.get("c") || "FreeSpinCarnival_20";

                    console.log('Preview Params:', params, c);

                    if (c) {
                        // 有参数 c -> 显示营销界面
                        console.log('Mode: Promo Loading');
                        activeLoadingPage = document.getElementById('promo-loading-page');

                        // 处理营销界面的图片显示逻辑
                        const match = c.match(/(\d+)$/);
                        const num = match ? Number(match[1]) : null;
                        if (num !== null) {
                            const numEl = document.querySelector(`.num-img[data-num="${num}"]`);
                            if (numEl) {
                                // numEl.src = numEl.dataset.src; // 不需要重新赋值src，HTML中已预设
                                numEl.style.display = "block";
                            }
                        }


                    } else {
                        // 无参数 c -> 显示默认界面
                        console.log('Mode: Default Loading');
                        activeLoadingPage = document.getElementById('default-loading-page');
                    }

                    // 显示选中的 Loading 页
                    if (activeLoadingPage) {
                        activeLoadingPage.style.display = 'block';
                    }

                    // 暴露给 Cocos 引擎调用的方法
					window.showProgressBar = function showProgressBar() {
						if(activeLoadingPage) activeLoadingPage.style.display = 'block';
					}
					window.hideLoadingPage = function hideLoadingPage() {
						console.log('hideLoadingPage');
                        if (!activeLoadingPage) return;

						activeLoadingPage.style.opacity = 0;
						activeLoadingPage.style.perspective = '1000px';
						activeLoadingPage.style.transition = 'all 0.2s ease-out';
						activeLoadingPage.addEventListener('transitionend', function () {
							activeLoadingPage.style.display = 'none';
						});
					}
				})();
			</script>

</body>
</html>