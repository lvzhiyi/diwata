#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# 启用调试模式
set -x

echo "=============== Pre-commit Hooks Debug ==============="

# 显示当前目录
echo "Current directory: $(pwd)"

# 显示暂存区文件
echo "Staged files:"
git diff --cached --name-only

# 运行 lint-staged
echo "\nRunning lint-staged..."
export DEBUG="lint-staged:*"
pnpm run lint:staged || {
  echo "❌ lint-staged failed"
  exit 1
}

# 运行 cocos 检查
echo "\nRunning cocos check..."
pnpm run check:cocos:staged || {
  echo "❌ cocos check failed"
  exit 1
}

echo "✅ Pre-commit hooks completed successfully"

# 关闭调试模式
set +x
