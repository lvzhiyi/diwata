    <!-- 默认 Loading -->
    <div class="loading-page" id="default-loading-page">
      <div class="loading-page-logo">
        <img src="./images/logo.ico" alt="logo" />
        <div class="loading-page-progress">
          <div class="progress-back"></div>
          <div class="progress-val" id="default-progress-val"></div>
        </div>
      </div>
    </div>

    <!-- 营销 Loading -->
    <div class="sm-logo-container" id="promo-loading-page">
      <div class="logo-container">
        <img class="sm-img" src="./images/logo.ico" />
        <div class="middle-box">
          <!-- 直接使用 src 预先请求图片，利用浏览器缓存，避免 JS 动态赋值 src 导致的加载延迟 -->
          <img class="num-img" data-num="10" src="./images/10.png" />
          <img class="num-img" data-num="20" src="./images/20.png" />
          <img
            class="free-img mayari"
            src="./images/malakas.png"
            style="display: none"
          />
        </div>
        <div class="progress-bar">
          <div class="progress-bar-inner" id="promo-progress-val"></div>
        </div>
        <div class="loading-text">Loading...</div>
      </div>
    </div>

    <div id="GameDiv" cc_exact_fit_screen="true">
      <div id="Cocos3dGameContainer">
        <canvas
          id="GameCanvas"
          oncontextmenu="event.preventDefault()"
          tabindex="99"
        ></canvas>
      </div>
    </div>

    <!-- Polyfills bundle. -->
    <script src="src/polyfills.bundle.5adbf.js" charset="utf-8"></script>

    <!-- SystemJS support. -->
    <script src="src/system.bundle.543e6.js" charset="utf-8"></script>

    {{ buildHashes }}
    <!-- 构建时生成的hash配置 -->
    <script src="getAB.js"></script>

    <script>
      (function () {
        // 解析参数
        var params = new URLSearchParams(location.search);
        var c = params.get('c');

        var activePage = null;

        if (c) {
          activePage = document.getElementById('promo-loading-page');

          // 图片逻辑
          var match = c.match(/(\d+)$/);
          var num = match ? Number(match[1]) : null;
          if (num !== null) {
            const numEl = document.querySelector(`.num-img[data-num="${num}"]`);
            if (numEl) {
              numEl.style.display = 'block';
            }
          }
          var gameEl = document.querySelector('.free-img.mayari');
          if (gameEl) gameEl.style.display = 'block';
        } else {
          console.log('Mode: Default');
          activePage = document.getElementById('default-loading-page');
        }

        // 显示
        if (activePage) activePage.style.display = 'block';

        window.showProgressBar = function () {
          if (activePage) activePage.style.display = 'block';
        };

        window.hideLoadingPage = function () {
          if (!activePage) return;
          activePage.style.opacity = 0;
          activePage.style.perspective = '1000px';
          activePage.style.transition = 'all 0.2s ease-out';
          activePage.addEventListener('transitionend', function () {
            activePage.style.display = 'none';
          });
        };
      })();

      if (window.location.hostname.includes('prod')) {
        Object.defineProperty(console, 'log', {
          get: function () {
            return function () {};
          },
        });
      }
    </script>
  </body>
</html>
